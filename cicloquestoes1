<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Plano de Estudos · Lana Biatriz · Ciclo em Blocos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Fraunces:opsz,wght@9..144,600;9..144,700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f6f5f2; --card:#ffffff; --ink:#1a1a1e; --mut:#6f6e76; --line:#e8e6e0;
  --accent:#4f46e5; --soft:#f1f0fb;
  --r:18px; --sh:0 1px 2px rgba(20,20,30,.05),0 8px 24px -12px rgba(20,20,30,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5;padding:48px 20px 80px}
.wrap{max-width:1120px;margin:0 auto}
a{color:inherit;text-decoration:none}
/* ---------- hero ---------- */
.hero{margin-bottom:40px}
.kicker{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);background:var(--soft);padding:7px 14px;border-radius:999px;margin-bottom:18px}
.kicker::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent)}
h1{font-family:'Fraunces',serif;font-size:clamp(30px,4.5vw,46px);font-weight:700;letter-spacing:-.02em;line-height:1.08}
h1 em{font-style:normal;color:var(--accent)}
.meta{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
.chip{display:inline-flex;align-items:center;gap:7px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:8px 15px;font-size:13px;font-weight:600;color:var(--ink);box-shadow:var(--sh)}
.chip span{color:var(--mut);font-weight:500}
/* ---------- section titles ---------- */
.sec{margin-top:52px}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:wrap}
h2{font-family:'Fraunces',serif;font-size:24px;font-weight:700;letter-spacing:-.01em}
.sec-head small{font-size:13px;color:var(--mut);font-weight:500}
/* ---------- week grid ---------- */
.week{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
.day{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:14px;box-shadow:var(--sh);display:flex;flex-direction:column;gap:10px}
.day-name{font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);padding:2px 2px 6px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.day-name i{font-style:normal;font-size:10px;font-weight:700;color:#b3b1ba}
.act{--c:#4f46e5;--cbg:#eef2ff;display:block;border-radius:14px;padding:11px 12px;background:var(--cbg);border:1px solid color-mix(in srgb,var(--c) 14%,transparent);position:relative;transition:transform .15s ease, box-shadow .15s ease}
.act:hover{transform:translateY(-2px);box-shadow:0 10px 22px -10px color-mix(in srgb,var(--c) 45%,transparent)}
.act .tag{display:inline-flex;align-items:center;gap:5px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--c);margin-bottom:6px}
.act .tag::before{content:"";width:6px;height:6px;border-radius:2px;background:var(--c)}
.act b{display:block;font-size:13px;font-weight:700;line-height:1.25;color:var(--ink)}
.act small{display:block;font-size:11px;color:var(--mut);margin-top:4px;font-weight:500}
.act .go{position:absolute;top:10px;right:10px;width:22px;height:22px;border-radius:50%;background:var(--card);color:var(--c);display:grid;place-items:center;font-size:11px;font-weight:800;box-shadow:0 1px 3px rgba(0,0,0,.12);opacity:.85}
.hourlab{font-size:10px;font-weight:700;color:#b3b1ba;letter-spacing:.08em;text-transform:uppercase}
/* ---------- rule banner ---------- */
.rulebar{margin-top:16px;background:linear-gradient(135deg,#1a1a2e,#2d2a55);color:#eceaff;border-radius:var(--r);padding:18px 22px;font-size:14px;font-weight:500;display:flex;gap:14px;align-items:center;box-shadow:var(--sh)}
.rulebar .ic{flex:0 0 38px;height:38px;border-radius:12px;background:rgba(255,255,255,.12);display:grid;place-items:center;font-size:17px}
.rulebar b{color:#fff}
/* ---------- two-col ---------- */
.cols{display:grid;grid-template-columns:1.15fr .85fr;gap:16px;align-items:start}
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--sh);padding:22px}
.card h3{font-family:'Fraunces',serif;font-size:18px;margin-bottom:14px}
.bar-row{display:grid;grid-template-columns:1fr 44px;gap:10px;align-items:center;padding:7px 0}
.bar-row+.bar-row{border-top:1px dashed var(--line)}
.bar-lab{display:flex;align-items:center;gap:9px;font-size:13px;font-weight:600}
.dot{width:10px;height:10px;border-radius:3px;flex:0 0 10px}
.bar-h{font-size:13px;font-weight:800;text-align:right;color:var(--mut)}
.bar-track{grid-column:1/-1;height:5px;border-radius:99px;background:#f0efe9;overflow:hidden;margin-top:-2px}
.bar-fill{height:100%;border-radius:99px}
.tot{display:flex;gap:10px;margin-top:16px}
.tot div{flex:1;background:var(--bg);border-radius:14px;padding:12px;text-align:center}
.tot b{display:block;font-size:20px;font-weight:800}
.tot span{font-size:11px;color:var(--mut);font-weight:600;text-transform:uppercase;letter-spacing:.06em}
.prio{display:flex;flex-direction:column;gap:10px}
.prio a,.prio .p{display:flex;gap:14px;align-items:center;background:var(--bg);border-radius:14px;padding:13px 15px;transition:background .15s}
.prio a:hover{background:var(--soft)}
.prio .n{flex:0 0 30px;height:30px;border-radius:10px;background:var(--ink);color:#fff;display:grid;place-items:center;font-size:14px;font-weight:800}
.prio b{font-size:13.5px;display:block}
.prio small{font-size:11.5px;color:var(--mut)}
/* ---------- frentes ---------- */
.fgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(330px,1fr));gap:14px}
.fcard{--c:#4f46e5;background:var(--card);border:1px solid var(--line);border-top:4px solid var(--c);border-radius:var(--r);box-shadow:var(--sh);padding:18px 18px 16px;display:flex;flex-direction:column;gap:10px}
.fcard .ft{display:flex;align-items:center;gap:10px}
.fcard .av{width:34px;height:34px;border-radius:11px;background:color-mix(in srgb,var(--c) 12%,white);color:var(--c);display:grid;place-items:center;font-weight:800;font-size:13px}
.fcard h4{font-size:15px;font-weight:700;flex:1;line-height:1.2}
.fcard .fr{font-size:10px;font-weight:800;letter-spacing:.1em;color:var(--mut);text-transform:uppercase}
.fcard p{font-size:12px;color:var(--mut);line-height:1.6}
.btns{display:flex;gap:8px;margin-top:auto;padding-top:6px}
.btn{flex:1;text-align:center;font-size:12px;font-weight:700;padding:9px 10px;border-radius:11px;border:1.5px solid var(--c);color:var(--c);transition:.15s}
.btn:hover{background:var(--c);color:#fff}
.btn.solid{background:var(--c);color:#fff}
.btn.solid:hover{filter:brightness(1.12)}
.btn.hard{border-style:dashed;opacity:.85}
.qlinks a.hardq{border-style:dashed;opacity:.85}
/* ---------- fila ---------- */
.queue{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.qitem{--c:#4f46e5;display:grid;grid-template-columns:34px 1fr auto;gap:12px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px;box-shadow:var(--sh)}
.qitem .qn{width:30px;height:30px;border-radius:10px;background:color-mix(in srgb,var(--c) 11%,white);color:var(--c);display:grid;place-items:center;font-size:13px;font-weight:800}
.qitem b{font-size:13.5px;display:block}
.qitem small{font-size:11px;color:var(--mut);display:block;line-height:1.45;margin-top:2px}
.qlinks{display:flex;flex-direction:column;gap:5px}
.qlinks a{font-size:11px;font-weight:700;color:var(--c);border:1.2px solid color-mix(in srgb,var(--c) 35%,transparent);padding:4px 10px;border-radius:8px;text-align:center;transition:.15s}
.qlinks a:hover{background:var(--c);color:#fff}
footer{margin-top:60px;text-align:center;color:var(--mut);font-size:13px}
footer b{font-family:'Fraunces',serif;font-size:15px;color:var(--ink)}
@media(max-width:980px){.week{grid-template-columns:repeat(3,1fr)}.cols{grid-template-columns:1fr}.queue{grid-template-columns:1fr}}
@media(max-width:560px){.week{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
