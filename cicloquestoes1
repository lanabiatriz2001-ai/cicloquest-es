        <circle id="ring" cx="75" cy="75" r="66" fill="none" stroke="var(--accent)" stroke-width="9" stroke-linecap="round" stroke-dasharray="414.7" stroke-dashoffset="0" transform="rotate(-90 75 75)" style="transition:stroke-dashoffset .3s linear"/>
      </svg>
      <div id="tdisp" style="position:absolute;inset:0;display:grid;place-items:center;font-size:30px;font-weight:800;letter-spacing:-.02em">60:00</div>
    </div>
    <div style="display:flex;gap:6px;justify-content:center;margin-bottom:10px">
      <button class="tp" data-m="60" style="background:var(--soft);color:var(--accent)">60</button>
