<style>.tp{border:1.5px solid var(--line);background:var(--card);font-weight:800;font-size:12px;width:40px;height:30px;border-radius:9px;cursor:pointer;color:var(--ink)}</style>
<script>
(function(){
var total=3600,left=3600,run=null,C=414.69;
var disp=document.getElementById('tdisp'),ring=document.getElementById('ring'),go=document.getElementById('tgo');
function fmt(s){var m=Math.floor(s/60),x=s%60;return (m<10?'0':'')+m+':'+(x<10?'0':'')+x}
function draw(){disp.textContent=fmt(left);ring.style.strokeDashoffset=C*(1-left/total);document.title=run?('('+fmt(left)+') Plano de Estudos'):'Plano de Estudos · Lana Biatriz · Ciclo em Blocos'}
function beep(){try{var a=new (window.AudioContext||window.webkitAudioContext)();var n=0;var f=function(){if(n++>5)return;var o=a.createOscillator(),g=a.createGain();o.connect(g);g.connect(a.destination);o.frequency.value=880;g.gain.setValueAtTime(.4,a.currentTime);g.gain.exponentialRampToValueAtTime(.001,a.currentTime+.35);o.start();o.stop(a.currentTime+.4);setTimeout(f,500)};f()}catch(e){}}
function tick(){if(left<=0){clearInterval(run);run=null;go.textContent='Iniciar';disp.style.color='#b91c1c';beep();draw();return}left--;draw()}
go.onclick=function(){if(run){clearInterval(run);run=null;go.textContent='Continuar'}else{if(left<=0)left=total;disp.style.color='';run=setInterval(tick,1000);go.textContent='Pausar'}draw()};
document.getElementById('trs').onclick=function(){clearInterval(run);run=null;left=total;disp.style.color='';go.textContent='Iniciar';draw()};
document.querySelectorAll('.tp').forEach(function(b){b.onclick=function(){clearInterval(run);run=null;total=left=60*parseInt(b.dataset.m);disp.style.color='';go.textContent='Iniciar';document.querySelectorAll('.tp').forEach(function(x){x.style.background='var(--card)';x.style.color='var(--ink)'});b.style.background='var(--soft)';b.style.color='var(--accent)';draw()}});
var open=true;document.getElementById('tmin').onclick=function(){open=!open;document.getElementById('tbody').style.display=open?'block':'none';document.getElementById('tmr').style.width=open?'240px':'150px';this.textContent=open?'–':'+'};
draw();
var c6n=0,c6=document.getElementById('c6'),dots=document.getElementById('c6dots'),msg=document.getElementById('c6msg');
function c6draw(){c6.textContent=c6n+'/6';dots.innerHTML='';for(var i=0;i<6;i++){var d=document.createElement('div');d.style.cssText='flex:1;height:6px;border-radius:99px;background:'+(i<c6n?'var(--accent)':'#f0efe9');dots.appendChild(d)}msg.style.display=(c6n>=6)?'block':'none'}
document.getElementById('c6add').onclick=function(){if(c6n>=6){c6n=0}else{c6n++}if(c6n>=6){beep()}c6draw()};
document.getElementById('c6rst').onclick=function(){c6n=0;c6draw()};
c6draw();
})();
</script>

